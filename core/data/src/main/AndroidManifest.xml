<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Пуш-уведомление о начале любимой пары (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Точное срабатывание будильника (Android 12+). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Автоматическое разрешение на точные будильники (Android 13+). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <!-- Принимает срабатывание будильника и показывает уведомление. -->
        <receiver
            android:name="com.example.myapp.data.notification.LessonReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.myapp.action.LESSON_REMINDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
